[Unit]
# 板端云出口：本地 RTSP → SRT → 云端 mediamtx
#
# 不写 Requires=fallguard-streamer-local：
# 本地推流没起来时，CloudSender 自己退避重连；写 Requires 会让本 unit 一起被拉停，
# 反而丢掉「云出口独立生命周期」这个设计目的。
Description=FallGuard cloud egress (local RTSP -> SRT)
After=network-online.target fallguard-streamer-local.service
Wants=network-online.target

[Service]
Type=simple
# 必须指定 User：numpy 装在 /opt/fallguard/.local 里，
# 默认以 root 跑会 ModuleNotFoundError。
User=fallguard
Group=fallguard
WorkingDirectory=/opt/fallguard/board
# 口令放 EnvironmentFile（600），不放 ExecStart 参数 —— 否则 `ps` 里能看见
# 先读 stream.env：本地拉流地址没显式给 `FG_CLOUD_LOCAL_RTSP` 时，
# 是由 `FG_STREAM_*` 拼出来的（见 scripts/run_cloud.py）。
# 不读这一份 ⇒ 推流端改了口令，云出口还在用默认值 ⇒ 401。
EnvironmentFile=-/etc/fallguard/stream.env
EnvironmentFile=-/etc/fallguard/cloud.env
ExecStart=/usr/bin/python3 /opt/fallguard/board/scripts/run_cloud.py

# 必须是 on-failure，不是 always：
# FG_CLOUD_SRT_URI 为空时 run_cloud.py 按 V1.2 约定 exit 0（不连接、不打日志）。
# always 会把「未启用」变成 5 秒一次的重启死循环。
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
