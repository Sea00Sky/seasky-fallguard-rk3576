# /etc/fallguard/cloud.env （chmod 600，root:root）
#
# 板端云出口环境变量。由 fallguard-streamer-cloud.service 通过
# EnvironmentFile= 读取 —— 不放 ExecStart 参数，否则 `ps` 里能看见口令。
#
# streamid 里含发布口令。SRT 的 streamid 在握手前的 induction 阶段明文传输，
# 所以它挡的是「随手推流」，挡不了抓包 —— 与 RTSP Basic 同一性质。
# 媒体内容本身由 FG_CLOUD_PASSPHRASE（AES）保护。

# 云服务器 SRT 入口
FG_CLOUD_SRT_URI=${FG_CLOUD_SRT_URI}

# publish:<path>:<user>:<pass> （mediamtx 自定义 streamid 格式）
FG_CLOUD_STREAMID=${FG_CLOUD_STREAMID}

# SRT AES 口令，必须与云端 mediamtx 的 srtPublishPassphrase 一致
FG_CLOUD_PASSPHRASE=${FG_CLOUD_PASSPHRASE}

# SRT 缓冲（毫秒）。手机热点抖动大，先 200，实测后再调
FG_CLOUD_LATENCY_MS=200

# 本地拉流地址；不写则由 FG_STREAM_* 自动拼（含凭据）
# FG_CLOUD_LOCAL_RTSP=rtsp://<user>:<password>@127.0.0.1:8554/live
