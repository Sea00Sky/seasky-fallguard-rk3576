# 本地 RTSP 推流的生效配置（装到 /etc/fallguard/stream.env，600）
#
# `fallguard-streamer-local` 和 `fallguard-streamer-cloud` 都读这一份。
# 云出口没显式给 `FG_CLOUD_LOCAL_RTSP` 时，会用 `FG_STREAM_*` 拼出本地拉流地址
# （见 scripts/run_cloud.py）。所以改口令只改这里一处，两边自动一致。
#
# 全部留注释 = 用代码默认值；要改就取消注释。

# --- 摄像头（mainpath，by-path 跨重启稳定；别写死 video42，编号会变）---
# FG_STREAM_DEVICE=/dev/v4l/by-path/platform-rkisp-vir1-video-index0

# --- 输出 ---
# FG_STREAM_PORT=8554
# FG_STREAM_MOUNT=/live

# --- 画质 ---
# FG_STREAM_WIDTH=1920
# FG_STREAM_HEIGHT=1080
# FG_STREAM_FPS=30
# FG_STREAM_BPS=4000000
# FG_STREAM_GOP=30

# --- 鉴权（默认开；关掉等于局域网谁都能拉病房画面）---
# FG_STREAM_AUTH=true
# FG_STREAM_USER=admin
# FG_STREAM_PASSWORD=<RTSP_PASSWORD>
