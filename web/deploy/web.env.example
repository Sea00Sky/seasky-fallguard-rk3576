# 衡护 HENGUARD 云端 Web —— 环境变量模板
# 用法：
#   sudo mkdir -p /etc/fallguard
#   sudo cp deploy/web.env.example /etc/fallguard/web.env
#   sudo chown root:fallguard /etc/fallguard/web.env
#   sudo chmod 640 /etc/fallguard/web.env        # 含密钥，绝不能 644
#   # 填好下面各项后：sudo systemctl restart fg-web
#
# 变量名必须与 app/config.py 的 Settings 字段一致（不区分大小写，通常写大写）。
# 注意：systemd 的 EnvironmentFile 不做 shell 展开（不认 $VAR、反引号、命令替换），
#       值按字面量读取；# 开头的行是注释。

# ── 数据库 ───────────────────────────────────────────────────────────
# psycopg3 的连接串。密码里若有 @ : / ? # 等字符，必须做 URL 编码（%40 %3A ...）。
# 应用账号只需 fg schema 的读写权限；不要用 postgres 超级用户跑 Web。
DATABASE_URL=postgresql://fg_app:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/fallguard

# ── 会话签名密钥 ─────────────────────────────────────────────────────
# 生成方法（在服务器上执行一次，把输出整行粘到下面）：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# 要求：≥ 48 字节的 URL-safe 随机串。
# 不配置的后果：config.py 每次启动随机生成一个，进程一重启所有人掉线；
# 换掉它 = 所有已登录会话立即失效（这是预期行为）。
# 禁止使用示例值、禁止提交到 Git、禁止写进论文附录。
SECRET_KEY=CHANGE_ME_RUN_python_-c_secrets.token_urlsafe(48)

# ── 会话 Cookie（设计 §8.2 / §10.2）─────────────────────────────────
# Cookie 名 fg_session；24 小时滑动有效期 + 30 分钟空闲超时。
# HTTP 环境下不加 Secure 标志（加了浏览器会直接丢弃，表现为登录成功但下一请求 401）。
SESSION_COOKIE=fg_session
SESSION_MAX_AGE=86400
IDLE_TIMEOUT=1800

# ── 快照存储 ─────────────────────────────────────────────────────────
# 快照根目录必须在 webroot 之外，只能经应用接口读取（设计 §8.7 / §10.3）。
# 目录权限 750，属主 fallguard:fallguard；应用会在其下按 YYYY/MM 建子目录。
SNAPSHOT_DIR=/var/lib/fallguard/snapshots

# ── 病区与时区 ───────────────────────────────────────────────────────
# 单病区部署时的默认病区号（与 db/seed.sql 的 4F-A 一致）
WARD_DEFAULT=4F-A
# 数据库里一律存 TIMESTAMPTZ（绝对时刻），展示与"按天"统计按此时区切日。
# 同时作为进程级 TZ 兜底（应用侧仍应显式用 zoneinfo，不依赖它）。
TZ=Asia/Shanghai

# ── 进程 ─────────────────────────────────────────────────────────────
# 日志直接进 journald：journalctl -u fg-web -f
# 注意：备注里的患者姓名等 PII 不得落日志（设计 §12.5）。
PYTHONUNBUFFERED=1
